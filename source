struct ContentView: View {
    @StateObject private var engine = PlayerEngine()
    @StateObject private var yt = YouTubeMirror()
    @StateObject private var sc = SoundCloudClient()

    @State private var source: Source = .youtube
    @State private var query = ""
    @State private var results: [YTVideo] = []
    @State private var status = ""
    @State private var showImporter = false
    @State private var percentMode = false

    @State private var lastFile: URL?
    @State private var testPlayer: AVPlayer?

    var body: some View {
        NavigationStack {
            List {
                Section("Источник") {
                    Picker("Источник", selection: $source) {
                        ForEach(Source.allCases) { Text($0.rawValue).tag($0) }
                    }
                    .pickerStyle(.segmented)
                    .onChange(of: source) { _, _ in
                        results = []
                        status = ""
                    }

                    if source == .youtube {
                        Picker("Качество аудио", selection: $yt.audioQuality) {
                            ForEach(AudioQuality.allCases) { Text($0.rawValue).tag($0) }
                        }
                    }

                    HStack {
                        TextField("поиск", text: $query)
                            .submitLabel(.search)
                            .onSubmit(runSearch)
                        Button("Найти", action: runSearch)
                    }

                    if !status.isEmpty {
                        Text(status)
                            .font(.footnote)
                            .foregroundStyle(.secondary)
                    }
                }

                if !results.isEmpty {
                    Section("Результаты") {
                        ForEach(results) { v in
                            Button { play(v) } label: {
                                VStack(alignment: .leading) {
                                    Text(v.title).lineLimit(2)
                                    Text(v.author)
                                        .font(.caption)
                                        .foregroundStyle(.secondary)
                                }
                            }
                        }
                    }
                }

                Section("Плеер: \(engine.title)") {
                    if !engine.info.isEmpty {
                        Text(engine.info)
                            .font(.caption)
                            .foregroundStyle(.secondary)
                    }

                    Slider(
                        value: Binding(get: { engine.position }, set: { engine.seek(to: $0) }),
                        in: 0...max(engine.duration, 1)
                    )

                    HStack {
                        Button {
                            testPlayer?.pause()
                            testPlayer = nil
                            engine.toggle()
                        } label: {
                            Image(systemName: engine.isPlaying ? "pause.fill" : "play.fill")
                                .font(.title)
                        }

                        Spacer()

                        Button("Файл") { showImporter = true }
                    }
                }

                Section("Питч") {
                    Picker("Единицы", selection: $percentMode) {
                        Text("Полутоны").tag(false)
                        Text("Проценты").tag(true)
                    }
                    .pickerStyle(.segmented)

                    if percentMode {
                        Text("\(Int(engine.pitchPercent.rounded()))%")
                        Slider(
                            value: Binding(get: { engine.pitchPercent }, set: { engine.pitchPercent = $0 }),
                            in: 50...200,
                            step: 1
                        )
                    } else {
                        Text(String(format: "%+.1f", engine.pitchSemitones))
                        Slider(value: $engine.pitchSemitones, in: -12...12, step: 0.5)
                    }

                    Toggle("Питч вместе со скоростью", isOn: $engine.linkPitchToRate)
                }

                Section("Скорость") {
                    Text("\(Int((engine.rate * 100).rounded()))%")
                    Slider(
                        value: Binding(get: { engine.rate * 100 }, set: { engine.rate = $0 / 100 }),
                        in: 25...400,
                        step: 5
                    )
                }

                Section("Диагностика треска") {
                    Text("Громкость движка: \(Int(engine.volume * 100))%")
                    Slider(value: $engine.volume, in: 0.1...1)

                    Button("Сыграть этот же файл системным плеером") {
                        engine.pause()
                        if let f = lastFile {
                            testPlayer = AVPlayer(url: f)
                            testPlayer?.play()
                        }
                    }
                    .disabled(lastFile == nil)

                    Button("Остановить системный плеер") {
                        testPlayer?.pause()
                        testPlayer = nil
                    }
                }
            }
            .navigationTitle("Tonika")
            .fileImporter(isPresented: $showImporter, allowedContentTypes: [.audio]) { r in
                if case .success(let url) = r { loadPicked(url) }
            }
        }
    }

    private func runSearch() {
        status = "Ищу..."
        let src = source

        Task {
            do {
                let r = switch src {
                case .youtube: try await yt.search(query)
                case .soundcloud: try await sc.search(query)
                }
                await MainActor.run {
                    results = r
                    status = r.isEmpty ? "Ничего не нашлось" : ""
                }
            } catch {
                await MainActor.run { status = error.localizedDescription }
            }
        }
    }

    private func play(_ v: YTVideo) {
        status = "Начинаю: \(v.title)"
        let src = source

        Task {
            do {
                let file = switch src {
                case .youtube:
                    try await yt.download(videoID: v.id) { s in
                        Task { @MainActor in status = s }
                    }
                case .soundcloud:
                    try await sc.download(v)
                }

                try await MainActor.run {
                    testPlayer?.pause()
                    testPlayer = nil
                    try engine.load(url: file, title: v.title)
                    engine.play()
                    lastFile = file
                    status = ""
                }
            } catch {
                await MainActor.run { status = error.localizedDescription }
            }
        }
    }

    private func loadPicked(_ url: URL) {
        let ok = url.startAccessingSecurityScopedResource()
        defer { if ok { url.stopAccessingSecurityScopedResource() } }

        do {
            let dest = FileManager.default.temporaryDirectory.appendingPathComponent(url.lastPathComponent)
            try? FileManager.default.removeItem(at: dest)
            try FileManager.default.copyItem(at: url, to: dest)

            testPlayer?.pause()
            testPlayer = nil
            try engine.load(url: dest)
            engine.play()
            lastFile = dest
        } catch {
            status = error.localizedDescription
        }
    }
}
