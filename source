@inline(__always)
func softLimit(_ x: Float) -> Float {
    let a = abs(x)
    if a <= 0.9 { return x }
    let y = 0.9 + 0.1 * tanh((a - 0.9) / 0.1)
    return x < 0 ? -y : y
}

// MARK: - PlayerEngine

final class PlayerEngine: ObservableObject {
    private let engine = AVAudioEngine()
    private var sourceNode: AVAudioSourceNode?
    private let lock = NSLock()

    private var samples: [Float] = []
    private var totalFrames = 0
    private var readIndex = 0
    private var sampleRate: Double = 44100
    private var stream: OpaquePointer?
    private var flushed = false
    private var finishedSent = false
    private var playing = false
    private var generation = 0
    private let scratch = UnsafeMutablePointer<Float>.allocate(capacity: 16384 * 2)

    private var timer: Timer?

    @Published var isPlaying = false
    @Published var duration: Double = 0
    @Published var position: Double = 0
    @Published var title = ""
    @Published var info = ""

    @Published var volume: Float = 1 {
        didSet { engine.mainMixerNode.outputVolume = volume }
    }

    @Published var pitchSemitones: Float = 0 {
        didSet { lock.lock(); applyParamsLocked(); lock.unlock() }
    }

    var pitchPercent: Float {
        get { 100 * pow(2, pitchSemitones / 12) }
        set { pitchSemitones = 12 * log2(min(max(newValue, 50), 200) / 100) }
    }

    @Published var rate: Float = 1 {
        didSet {
            lock.lock(); applyParamsLocked(); lock.unlock()
            updateNowPlaying()
        }
    }

    @Published var linkPitchToRate = false {
        didSet { lock.lock(); applyParamsLocked(); lock.unlock() }
    }

    var currentTime: Double {
        lock.lock(); defer { lock.unlock() }
        return Double(readIndex) / sampleRate
    }

    init() {
        try? AVAudioSession.sharedInstance().setCategory(.playback, mode: .default)

        let nc = NotificationCenter.default
        nc.addObserver(forName: AVAudioSession.interruptionNotification, object: nil, queue: .main) { [weak self] n in
            guard let self,
                  let raw = n.userInfo?[AVAudioSessionInterruptionTypeKey] as? UInt,
                  let type = AVAudioSession.InterruptionType(rawValue: raw) else { return }

            if type == .began {
                self.lock.lock(); self.playing = false; self.lock.unlock()
                self.isPlaying = false
            } else {
                let opts = n.userInfo?[AVAudioSessionInterruptionOptionKey] as? UInt ?? 0
                if AVAudioSession.InterruptionOptions(rawValue: opts).contains(.shouldResume) {
                    self.play()
                }
            }
        }

        nc.addObserver(forName: AVAudioSession.routeChangeNotification, object: nil, queue: .main) { [weak self] n in
            guard let raw = n.userInfo?[AVAudioSessionRouteChangeReasonKey] as? UInt,
                  AVAudioSession.RouteChangeReason(rawValue: raw) == .oldDeviceUnavailable else { return }
            self?.pause()
        }

        nc.addObserver(forName: .AVAudioEngineConfigurationChange, object: engine, queue: .main) { [weak self] _ in
            guard let self, self.isPlaying else { return }
            try? self.engine.start()
        }

        setupRemoteCommands()

        timer = Timer.scheduledTimer(withTimeInterval: 0.25, repeats: true) { [weak self] _ in
            guard let self, self.isPlaying else { return }
            self.position = self.currentTime
        }
    }

    deinit {
        if let s = stream { sonicDestroyStream(s) }
        scratch.deallocate()
    }


    private func decodeWithAssetReader(url: URL) throws -> (samples: [Float], rate: Double) {
        let asset = AVURLAsset(url: url)
        guard let track = asset.tracks(withMediaType: .audio).first else { throw MirrorError.parse }

        let reader = try AVAssetReader(asset: asset)
        let settings: [String: Any] = [
            AVFormatIDKey: kAudioFormatLinearPCM,
            AVSampleRateKey: 44100,
            AVNumberOfChannelsKey: 2,
            AVLinearPCMBitDepthKey: 32,
            AVLinearPCMIsFloatKey: true,
            AVLinearPCMIsBigEndianKey: false,
            AVLinearPCMIsNonInterleaved: false
        ]
        let output = AVAssetReaderTrackOutput(track: track, outputSettings: settings)
        guard reader.canAdd(output) else { throw MirrorError.parse }
        reader.add(output)
        guard reader.startReading() else { throw reader.error ?? MirrorError.parse }

        var out = [Float]()
        while let sb = output.copyNextSampleBuffer() {
            if let block = CMSampleBufferGetDataBuffer(sb) {
                let count = CMBlockBufferGetDataLength(block) / MemoryLayout<Float>.size
                if count > 0 {
                    var chunk = [Float](repeating: 0, count: count)
                    chunk.withUnsafeMutableBytes { raw in
                        _ = CMBlockBufferCopyDataBytes(
                            block,
                            atOffset: 0,
                            dataLength: count * MemoryLayout<Float>.size,
                            destination: raw.baseAddress!
                        )
                    }
                    out.append(contentsOf: chunk)
                }
            }
            CMSampleBufferInvalidate(sb)
        }

        if reader.status == .failed { throw reader.error ?? MirrorError.parse }
        if out.count % 2 == 1 { out.removeLast() }
        return (out, 44100)
    }

    private func decodeWithAudioFile(url: URL) throws -> (samples: [Float], rate: Double) {
        let f = try AVAudioFile(forReading: url)
        let fmt = f.processingFormat
        let chCount = Int(fmt.channelCount)
        let chunk: AVAudioFrameCount = 32768
        guard let buf = AVAudioPCMBuffer(pcmFormat: fmt, frameCapacity: chunk) else {
            throw MirrorError.parse
        }

        var out = [Float]()
        out.reserveCapacity(Int(f.length) * 2)

        while f.framePosition < f.length {
            try f.read(into: buf, frameCount: chunk)
            let n = Int(buf.frameLength)
            if n == 0 { break }
            guard let ch = buf.floatChannelData else { break }

            let l = ch[0]
            let r = chCount > 1 ? ch[1] : ch[0]
            for i in 0..<n {
                out.append(l[i])
                out.append(r[i])
            }
        }
        return (out, fmt.sampleRate)
    }

    private func decodeFile(url: URL) throws -> (samples: [Float], rate: Double, method: String) {
        if let r = try? decodeWithAssetReader(url: url), r.samples.count > 1000 {
            return (r.samples, r.rate, "AVAssetReader")
        }
        let r = try decodeWithAudioFile(url: url)
        return (r.samples, r.rate, "AVAudioFile")
    }


    func load(url: URL, title: String? = nil) throws {
        engine.stop()

        let decoded = try decodeFile(url: url)
        var out = decoded.samples
        guard out.count >= 4 else { throw MirrorError.parse }
        let sr = decoded.rate

        var peak: Float = 0
        var over = 0
        for v in out {
            let a = abs(v)
            if a > peak { peak = a }
            if a > 1.0 { over += 1 }
        }

        var gainNote = ""
        if peak > 0.98 {
            let g = 0.98 / peak
            for i in 0..<out.count { out[i] *= g }
            gainNote = ", приглушено ×" + String(format: "%.2f", g)
        }

        let bytes = ((try? FileManager.default.attributesOfItem(atPath: url.path))?[.size] as? NSNumber)?.intValue ?? 0

        lock.lock()
        generation += 1
        samples = out
        totalFrames = out.count / 2
        readIndex = 0
        sampleRate = sr
        playing = false
        resetStreamLocked()
        let total = totalFrames
        lock.unlock()

        rebuildSourceNode(sampleRate: sr)

        duration = Double(total) / sr
        info = "\(decoded.method), \(Int(sr)) Гц, \(Int(duration)) сек, \(bytes / 1024) КБ, пик \(String(format: "%.2f", peak)), выше 1.0: \(over)\(gainNote)"
        self.title = title ?? url.deletingPathExtension().lastPathComponent
        isPlaying = false
        position = 0
        updateNowPlaying()
    }

    func play() {
        lock.lock(); let ok = totalFrames > 0; lock.unlock()
        guard ok else { return }

        do {
            try AVAudioSession.sharedInstance().setActive(true)
            if !engine.isRunning { try engine.start() }
            lock.lock(); playing = true; lock.unlock()
            isPlaying = true
            updateNowPlaying()
        } catch {
            print("play error:", error)
        }
    }

    func pause() {
        lock.lock(); playing = false; lock.unlock()
        engine.pause()
        isPlaying = false
        position = currentTime
        updateNowPlaying()
    }

    func toggle() { isPlaying ? pause() : play() }

    func seek(to seconds: Double) {
        lock.lock()
        guard totalFrames > 0 else { lock.unlock(); return }

        let frame = Int(min(max(0, seconds), Double(totalFrames) / sampleRate) * sampleRate)
        readIndex = min(frame, totalFrames)
        resetStreamLocked()
        lock.unlock()

        position = min(max(0, seconds), duration)
        updateNowPlaying()
    }


    private func rebuildSourceNode(sampleRate: Double) {
        if let old = sourceNode { engine.detach(old) }

        let fmt = AVAudioFormat(standardFormatWithSampleRate: sampleRate, channels: 2)!
        let node = AVAudioSourceNode(format: fmt) { [weak self] _, _, frameCount, abl -> OSStatus in
            guard let self else { return noErr }
            return self.render(frameCount: Int(frameCount), abl: abl)
        }

        engine.attach(node)
        engine.connect(node, to: engine.mainMixerNode, format: fmt)
        sourceNode = node
    }

    private func render(frameCount: Int, abl: UnsafeMutablePointer<AudioBufferList>) -> OSStatus {
        let bufs = UnsafeMutableAudioBufferListPointer(abl)
        let n = min(frameCount, 16384)
        var produced = 0
        var justEnded = false
        var gen = 0

        lock.lock()
        if playing, let s = stream {
            while produced < n {
                let got = Int(sonicReadFloatFromStream(s, scratch + produced * 2, Int32(n - produced)))
                produced += got

                if produced >= n { break }
                if got > 0 { continue }

                if readIndex < totalFrames {
                    let c = min(1024, totalFrames - readIndex)
                    let base = readIndex * 2

                    samples.withUnsafeMutableBufferPointer { p in
                        _ = sonicWriteFloatToStream(s, p.baseAddress! + base, Int32(c))
                    }
                    readIndex += c
                } else if !flushed {
                    sonicFlushStream(s)
                    flushed = true
                } else {
                    if !finishedSent {
                        finishedSent = true
                        justEnded = true
                        gen = generation
                    }
                    break
                }
            }
        }
        lock.unlock()

        for ch in 0..<bufs.count {
            guard let data = bufs[ch].mData?.assumingMemoryBound(to: Float.self) else { continue }
            let c = min(ch, 1)
            for i in 0..<frameCount {
                data[i] = i < produced ? softLimit(scratch[i * 2 + c]) : 0
            }
        }

        if justEnded {
            DispatchQueue.main.async { [weak self] in
                self?.trackEnded(generation: gen)
            }
        }

        return noErr
    }

    private func trackEnded(generation g: Int) {
        lock.lock()
        guard g == generation else { lock.unlock(); return }
        playing = false
        readIndex = 0
        resetStreamLocked()
        lock.unlock()

        engine.pause()
        isPlaying = false
        position = 0
        updateNowPlaying()
    }

    private func resetStreamLocked() {
        if let s = stream { sonicDestroyStream(s) }
        stream = sonicCreateStream(Int32(sampleRate), 2)
        if let s = stream { sonicSetQuality(s, 0) }

        flushed = false
        finishedSent = false
        applyParamsLocked()
    }

    private func applyParamsLocked() {
        guard let s = stream else { return }

        let semis = min(max(pitchSemitones, -12), 12)
        let pitchMult = pow(2, semis / 12)

        if linkPitchToRate {
            sonicSetSpeed(s, 1)
            sonicSetRate(s, rate)
        } else {
            sonicSetSpeed(s, rate)
            sonicSetRate(s, 1)
        }
        sonicSetPitch(s, pitchMult)
    }

    private func setupRemoteCommands() {
        let c = MPRemoteCommandCenter.shared()

        c.playCommand.addTarget { [weak self] _ in
            DispatchQueue.main.async { self?.play() }
            return .success
        }
        c.pauseCommand.addTarget { [weak self] _ in
            DispatchQueue.main.async { self?.pause() }
            return .success
        }
        c.togglePlayPauseCommand.addTarget { [weak self] _ in
            DispatchQueue.main.async { self?.toggle() }
            return .success
        }
        c.changePlaybackPositionCommand.addTarget { [weak self] e in
            guard let e = e as? MPChangePlaybackPositionCommandEvent else { return .commandFailed }
            DispatchQueue.main.async { self?.seek(to: e.positionTime) }
            return .success
        }
    }

    func updateNowPlaying() {
        MPNowPlayingInfoCenter.default().nowPlayingInfo = [
            MPMediaItemPropertyTitle: title,
            MPMediaItemPropertyPlaybackDuration: duration,
            MPNowPlayingInfoPropertyElapsedPlaybackTime: currentTime,
            MPNowPlayingInfoPropertyPlaybackRate: isPlaying ? Double(rate) : 0.0
        ]
    }
}


struct YTVideo: Identifiable {
    let id: String
    let title: String
    let author: String
    var extra: [String: String] = [:]
}

enum Source: String, CaseIterable, Identifiable {
    case youtube = "YouTube"
    case soundcloud = "SoundCloud"
    var id: String { rawValue }
}

enum AudioQuality: String, CaseIterable, Identifiable {
    case low = "Низкое"
    case medium = "Среднее"
    case maximum = "Максимальное"
    var id: String { rawValue }
}

enum MirrorError: LocalizedError {
    case badResponse(Int), noAudio, noProgressive, parse
    case timeout(String)

    var errorDescription: String? {
        switch self {
        case .badResponse(let c):
            return "Сервер ответил кодом \(c). Попробуй другой трек или повтори позже"
        case .noAudio:
            return "Не нашёл m4a-аудио для этого видео"
        case .noProgressive:
            return "У этого трека нет mp3-потока (только HLS), такие не поддерживаются. Попробуй другой трек"
        case .parse:
            return "Не смог разобрать ответ сервера или прочитать файл"
        case .timeout(let stage):
            return "Завис на шаге: \(stage). Попробуй другой трек или повтори"
        }
    }
}

func withTimeout<T>(seconds: Double, stage: String, _ op: @escaping () async throws -> T) async throws -> T {
    try await withThrowingTaskGroup(of: T.self) { group in
        group.addTask { try await op() }
        group.addTask {
            try await Task.sleep(nanoseconds: UInt64(seconds * 1_000_000_000))
            throw MirrorError.timeout(stage)
        }
        let result = try await group.next()!
        group.cancelAll()
        return result
    }
}


final class YouTubeMirror: ObservableObject {
    @Published var audioQuality: AudioQuality = .maximum

    private let searchURL = URL(string: "https://www.youtube.com/youtubei/v1/search?prettyPrint=false")!
    private let clientVersion = "2.20241126.01.00"

    func search(_ query: String) async throws -> [YTVideo] {
        let trimmed = query.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !trimmed.isEmpty else { return [] }

        var request = URLRequest(url: searchURL)
        request.httpMethod = "POST"
        request.timeoutInterval = 25
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        request.setValue("1", forHTTPHeaderField: "X-YouTube-Client-Name")
        request.setValue(clientVersion, forHTTPHeaderField: "X-YouTube-Client-Version")
        request.setValue("https://www.youtube.com", forHTTPHeaderField: "Origin")
        request.setValue("Mozilla/5.0", forHTTPHeaderField: "User-Agent")

        let body: [String: Any] = [
            "context": [
                "client": [
                    "clientName": "WEB",
                    "clientVersion": clientVersion,
                    "hl": "en",
                    "gl": "US"
                ]
            ],
            "query": trimmed
        ]
        request.httpBody = try JSONSerialization.data(withJSONObject: body)

        let (data, response) = try await URLSession.shared.data(for: request)
        if let code = (response as? HTTPURLResponse)?.statusCode, code != 200 {
            throw MirrorError.badResponse(code)
        }

        let json = try JSONSerialization.jsonObject(with: data)
        var renderers: [[String: Any]] = []
        collectVideoRenderers(in: json, into: &renderers)

        var seen = Set<String>()
        return renderers.compactMap { item in
            guard let id = item["videoId"] as? String,
                  !id.isEmpty,
                  seen.insert(id).inserted else { return nil }

            let title = textValue(item["title"])
            guard !title.isEmpty else { return nil }

            return YTVideo(
                id: id,
                title: title,
                author: textValue(item["ownerText"])
            )
        }
    }

    private func collectVideoRenderers(in value: Any, into result: inout [[String: Any]]) {
        if let dict = value as? [String: Any] {
            if let renderer = dict["videoRenderer"] as? [String: Any] {
                result.append(renderer)
            }
            for child in dict.values { collectVideoRenderers(in: child, into: &result) }
        } else if let array = value as? [Any] {
            for child in array { collectVideoRenderers(in: child, into: &result) }
        }
    }

    private func textValue(_ value: Any?) -> String {
        guard let dict = value as? [String: Any] else { return "" }
        if let simple = dict["simpleText"] as? String { return simple }
        if let runs = dict["runs"] as? [[String: Any]] {
            return runs.compactMap { $0["text"] as? String }.joined()
        }
        return ""
    }

    func audioURL(videoID: String) async throws -> URL {
        let quality = audioQuality
        return try await withTimeout(seconds: 25, stage: "достаю ссылку на аудио") {
            let streams = try await YouTube(videoID: videoID).streams
            let m4a = streams.filterAudioOnly().filter { $0.fileExtension == .m4a }
            let chosen = (quality == .low) ? m4a.lowestAudioBitrateStream() : m4a.highestAudioBitrateStream()
            guard let selected = chosen else { throw MirrorError.noAudio }
            return selected.url
        }
    }

    func download(videoID: String, onStage: @escaping (String) -> Void) async throws -> URL {
        onStage("Достаю ссылку на аудио...")
        let remote = try await audioURL(videoID: videoID)

        let destination = FileManager.default.temporaryDirectory.appendingPathComponent("\(videoID).m4a")
        try? FileManager.default.removeItem(at: destination)
        FileManager.default.createFile(atPath: destination.path, contents: nil)
        let handle = try FileHandle(forWritingTo: destination)
        defer { try? handle.close() }

        let chunkSize = 1_000_000
        var offset = 0
        var total: Int?

        while true {
            var request = URLRequest(url: remote)
            request.timeoutInterval = 15
            request.setValue("bytes=\(offset)-\(offset + chunkSize - 1)", forHTTPHeaderField: "Range")
            request.setValue("Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1", forHTTPHeaderField: "User-Agent")
            request.setValue("https://www.youtube.com", forHTTPHeaderField: "Origin")
            request.setValue("https://www.youtube.com/", forHTTPHeaderField: "Referer")

            var attempt = 0
            var data = Data()
            var http: HTTPURLResponse?
            while true {
                do {
                    let (d, r) = try await withTimeout(seconds: 20, stage: "качаю кусок файла") {
                        try await URLSession.shared.data(for: request)
                    }
                    data = d
                    http = r as? HTTPURLResponse
                    break
                } catch {
                    attempt += 1
                    if attempt >= 3 { throw error }
                }
            }

            guard let http else { throw MirrorError.parse }
            guard http.statusCode == 200 || http.statusCode == 206 else {
                throw MirrorError.badResponse(http.statusCode)
            }

            if http.statusCode == 200 {
                try handle.write(contentsOf: data)
                break
            }

            if total == nil,
               let cr = http.value(forHTTPHeaderField: "Content-Range"),
               let slash = cr.lastIndex(of: "/"),
               let t = Int(cr[cr.index(after: slash)...]) {
                total = t
            }

            if data.isEmpty { break }
            try handle.write(contentsOf: data)
            offset += data.count

            if let t = total {
                onStage("Качаю файл: \(min(100, offset * 100 / max(t, 1)))%")
                if offset >= t { break }
            } else {
                onStage("Качаю файл: \(offset / 1000) КБ")
                if data.count < chunkSize { break }
            }
        }

        return destination
    }
}


final class SoundCloudClient: ObservableObject {
    private var clientID: String?
    private let ua = "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1"

    private func fetch(_ url: URL) async throws -> Data {
        var req = URLRequest(url: url)
        req.timeoutInterval = 20
        req.setValue(ua, forHTTPHeaderField: "User-Agent")

        let (data, resp) = try await URLSession.shared.data(for: req)
        if let code = (resp as? HTTPURLResponse)?.statusCode, code != 200 {
            throw MirrorError.badResponse(code)
        }
        return data
    }

    private func getClientID(refresh: Bool) async throws -> String {
        if !refresh {
            if let c = clientID { return c }
            if let c = UserDefaults.standard.string(forKey: "scClientID") {
                clientID = c
                return c
            }
        }

        guard let home = URL(string: "https://soundcloud.com") else { throw MirrorError.parse }
        let html = String(decoding: try await fetch(home), as: UTF8.self)

        let scriptRegex = try NSRegularExpression(pattern: "https://a-v2\\.sndcdn\\.com/assets/[^\"']+\\.js")
        let ns = html as NSString
        let scripts = scriptRegex.matches(in: html, range: NSRange(location: 0, length: ns.length))
            .map { ns.substring(with: $0.range) }

        let idRegex = try NSRegularExpression(pattern: "client_id\\s*[:=]\\s*\"([A-Za-z0-9]{32})\"")

        for s in scripts.reversed() {
            guard let url = URL(string: s), let data = try? await fetch(url) else { continue }
            let js = String(decoding: data, as: UTF8.self)
            let jns = js as NSString

            if let m = idRegex.firstMatch(in: js, range: NSRange(location: 0, length: jns.length)) {
                let id = jns.substring(with: m.range(at: 1))
                clientID = id
                UserDefaults.standard.set(id, forKey: "scClientID")
                return id
            }
        }

        throw MirrorError.parse
    }

    private func apiJSON(_ urlString: String, _ query: [URLQueryItem]) async throws -> [String: Any] {
        for attempt in 0..<2 {
            let cid = try await getClientID(refresh: attempt == 1)
            guard var comps = URLComponents(string: urlString) else { throw MirrorError.parse }
            comps.queryItems = query + [URLQueryItem(name: "client_id", value: cid)]
            guard let url = comps.url else { throw MirrorError.parse }

            do {
                let data = try await fetch(url)
                guard let json = try JSONSerialization.jsonObject(with: data) as? [String: Any] else {
                    throw MirrorError.parse
                }
                return json
            } catch MirrorError.badResponse(let code) where (code == 401 || code == 403) && attempt == 0 {
                continue
            }
        }
        throw MirrorError.parse
    }

    func search(_ q: String) async throws -> [YTVideo] {
        let json = try await apiJSON(
            "https://api-v2.soundcloud.com/search/tracks",
            [URLQueryItem(name: "q", value: q), URLQueryItem(name: "limit", value: "20")]
        )
        guard let arr = json["collection"] as? [[String: Any]] else { throw MirrorError.parse }

        return arr.compactMap { d in
            guard let id = d["id"] as? Int else { return nil }

            let media = d["media"] as? [String: Any]
            let transcodings = media?["transcodings"] as? [[String: Any]] ?? []
            let progressive = transcodings.first { ($0["format"] as? [String: Any])?["protocol"] as? String == "progressive" }?["url"] as? String ?? ""
            let user = d["user"] as? [String: Any]

            return YTVideo(
                id: String(id),
                title: d["title"] as? String ?? "",
                author: user?["username"] as? String ?? "",
                extra: [
                    "prog": progressive,
                    "auth": d["track_authorization"] as? String ?? ""
                ]
            )
        }
    }

    func download(_ v: YTVideo) async throws -> URL {
        guard let prog = v.extra["prog"], !prog.isEmpty else { throw MirrorError.noProgressive }

        let json = try await apiJSON(prog, [URLQueryItem(name: "track_authorization", value: v.extra["auth"] ?? "")])
        guard let s = json["url"] as? String, let remote = URL(string: s) else { throw MirrorError.parse }

        let (tmp, resp) = try await URLSession.shared.download(from: remote)
        if let code = (resp as? HTTPURLResponse)?.statusCode, code != 200 {
            throw MirrorError.badResponse(code)
        }

        let dest = FileManager.default.temporaryDirectory.appendingPathComponent("sc\(v.id).mp3")
        try? FileManager.default.removeItem(at: dest)
        try FileManager.default.moveItem(at: tmp, to: dest)
        return dest
    }
}

